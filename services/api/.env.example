# Database Configuration
POSTGRES_USER=ipmd_admin
POSTGRES_PASSWORD=ipmd_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ipmd_db
DATABASE_URL=postgresql://ipmd_admin:ipmd_secret@localhost:5434/ipmd_db

# Security & JWT
JWT_SECRET_KEY=super-secret-ipmd-jwt-key-2026-secure-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_SECONDS=300

# Razorpay Integration (Test/Live)
RAZORPAY_KEY_ID=rzp_test_ipmd2026mockkey
RAZORPAY_KEY_SECRET=mock_razorpay_secret_key_2026

# Storage Configuration (MinIO / S3-compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=ipmd-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_LOCAL_PATH=./storage
STORAGE_SIGNED_URL_EXPIRES=300

# File Upload Validation
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,application/pdf

# Malware Scanning
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_TIMEOUT=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
