# ==============================================================================
# IPMD Platform Environment Configuration
# Copy this file to '.env' in the root directory:
#   cp .env.example .env
# ==============================================================================

# AI / ML API Keys (Services/AI Microservice)
# ------------------------------------------------------------------------------
# Google Cloud Vision API Key for OCR Document Processing
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here

# OpenAI API Key for GPT-4o Medical Entity Structuring & Diagnostic Report Parsing
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Google Gemini API Key for Gemini 1.5 Chat Assistant & RAG Embeddings
GEMINI_API_KEY=your_google_gemini_api_key_here


# Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=ipmd_admin
POSTGRES_PASSWORD=ipmd_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ipmd_db


# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=super-secret-ipmd-jwt-key-2026-secure-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30


# Razorpay Payment Gateway (Test Mode / Live)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_ipmd2026mockkey
RAZORPAY_KEY_SECRET=mock_razorpay_secret_key_2026


# Storage Configuration (MinIO / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage


# Redis & Celery Task Queue
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
